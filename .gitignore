# ---------------------------------------------------------------------------
# PathSnap .gitignore
# ---------------------------------------------------------------------------

# --- Virtual environments / local Python env (DO NOT COMMIT, ~824 MB) -------
.venv/
venv/
env/
ENV/
.python-version

# --- Raw datasets & source archives (large, read-only; keep out of git) -----
# The raw "Student folder" dataset must never be committed or modified.
data/raw/
data/processed/
*.zip

# --- Generated / large output artifacts -------------------------------------
# Keep the folder (via outputs/.gitkeep) but ignore everything generated in it.
outputs/*
!outputs/.gitkeep
# Serialized model/artifact blobs anywhere in the tree.
*.joblib
*.pkl
*.pickle
*.h5
*.onnx
*.db                 # optuna study databases
# Exported folium maps under outputs/ are regenerated from code (not committed).
outputs/maps/*.html

# --- Secrets / local environment files --------------------------------------
.env
.env.*
*.secret
secrets.*
credentials.*
*.key
*.pem

# --- Python caches / build ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Jupyter -----------------------------------------------------------------
profile_default/
ipython_config.py

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Tracked on purpose (NOT ignored):
#   docs/      -> PDFs + the three audit markdown files (deliverable)
#   reports/   -> technical report lives here; owner decides what to commit
#   frontend/  -> UI source (including any .html) is committed
# ---------------------------------------------------------------------------
