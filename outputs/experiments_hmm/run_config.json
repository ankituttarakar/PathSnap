{
  "seed": 42,
  "quick_mode": false,
  "cand_radius_m": 60.0,
  "max_candidates": 15,
  "align_radius_m": 60.0,
  "label_max_dist_m": 50.0,
  "max_points_per_trip": 400,
  "cv_folds": 5,
  "seq_len_train": 600,
  "seq_len_test": null,
  "max_hops": 3,
  "gap_s": 30.0,
  "decoder_grid": {
    "hop_pen": [
      0.5,
      1.5
    ],
    "jump_pen": [
      3.0,
      6.0,
      10.0
    ],
    "uturn_pen": [
      3.0,
      8.0
    ],
    "emission_weight": [
      1.0
    ]
  },
  "features": [
    "dist",
    "dist_rank",
    "dist_minus_min",
    "n_cands",
    "signed_offset",
    "head_cos",
    "head_valid",
    "turn_cos",
    "frac",
    "arc_len",
    "has_reverse",
    "speed",
    "dt_prev",
    "along_move",
    "dist_prev",
    "dist_next",
    "dist_prev3",
    "dist_next3",
    "dist_nb_mean",
    "connect_prev"
  ],
  "models": {
    "1_LogisticRegression": {
      "family": "Linear/probabilistic",
      "params": {
        "C": 1.0,
        "max_iter": 500
      }
    },
    "2_GaussianNB": {
      "family": "Linear/probabilistic",
      "params": {
        "var_smoothing": 1e-09
      }
    },
    "3_RandomForest": {
      "family": "Ensemble",
      "params": {
        "n_estimators": 200,
        "max_depth": 16,
        "min_samples_leaf": 5
      }
    },
    "4_ExtraTrees": {
      "family": "Tree/Ensemble",
      "params": {
        "n_estimators": 200,
        "max_depth": 18,
        "min_samples_leaf": 5
      }
    },
    "5_LightGBM": {
      "family": "Boosting",
      "params": {
        "n_estimators": 400,
        "learning_rate": 0.05,
        "num_leaves": 31,
        "subsample": 0.8,
        "subsample_freq": 1,
        "colsample_bytree": 0.8
      }
    },
    "6_XGBoost": {
      "family": "Boosting",
      "params": {
        "n_estimators": 400,
        "learning_rate": 0.08,
        "max_depth": 6,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "tree_method": "hist"
      }
    },
    "7_MLP": {
      "family": "Neural network",
      "params": {
        "hidden_layer_sizes": [
          64,
          32
        ],
        "alpha": 0.0001,
        "max_iter": 200,
        "early_stopping": true
      }
    },
    "8_LinearSVM_calibrated": {
      "family": "Kernel-based (linear)",
      "params": {
        "C": 0.5,
        "cv": 3
      }
    }
  }
}